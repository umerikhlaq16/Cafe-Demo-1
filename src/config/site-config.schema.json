{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "site-config.schema.json",
  "title": "Demo1 website content configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["site", "navbar", "hero", "whySection", "productsSection", "storySection", "parfaitsSection", "appDownloadSection", "footer"],
  "properties": {
    "$schema": { "type": "string" },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "homeUrl"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "homeUrl": { "type": "string", "minLength": 1 }
      }
    },
    "navbar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ariaLabel", "links", "cta"],
      "properties": {
        "ariaLabel": { "type": "string", "minLength": 1 },
        "links": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/link" }
        },
        "cta": { "$ref": "#/$defs/link" }
      }
    },
    "hero": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eyebrow", "title", "description", "backgroundImage", "cta"],
      "properties": {
        "eyebrow": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "backgroundImage": { "type": "string", "minLength": 1 },
        "cta": { "$ref": "#/$defs/link" }
      }
    },
    "whySection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eyebrow", "title", "intro", "items"],
      "properties": {
        "eyebrow": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "intro": { "type": "string", "minLength": 1 },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "description"],
            "properties": {
              "title": { "type": "string", "minLength": 1 },
              "description": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "productsSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eyebrow", "title", "footerText", "items"],
      "properties": {
        "eyebrow": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "footerText": { "type": "string", "minLength": 1 },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "price", "description", "image", "imageAlt"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "price": { "type": "string", "minLength": 1 },
              "description": { "type": "string", "minLength": 1 },
              "image": { "type": "string", "minLength": 1 },
              "imageAlt": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "storySection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["badge", "eyebrow", "title", "description", "image", "imageAlt", "cta"],
      "properties": {
        "badge": { "type": "string", "minLength": 1 },
        "eyebrow": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "image": { "type": "string", "minLength": 1 },
        "imageAlt": { "type": "string", "minLength": 1 },
        "cta": { "$ref": "#/$defs/link" }
      }
    },
    "parfaitsSection": {
      "$ref": "#/properties/productsSection"
    },
    "appDownloadSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eyebrow", "title", "description", "image", "imageAlt", "features", "stores"],
      "properties": {
        "eyebrow": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "image": { "type": "string", "minLength": 1 },
        "imageAlt": { "type": "string", "minLength": 1 },
        "features": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "stores": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "href", "icon"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "href": { "type": "string", "minLength": 1 },
              "icon": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "footer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tagline", "email", "copyright", "links", "socials"],
      "properties": {
        "tagline": { "type": "string", "minLength": 1 },
        "email": { "type": "string", "minLength": 1 },
        "copyright": { "type": "string", "minLength": 1 },
        "links": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/link" } },
        "socials": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/link" } }
      }
    }
  },
  "$defs": {
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "href"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "href": { "type": "string", "minLength": 1 }
      }
    }
  }
}
